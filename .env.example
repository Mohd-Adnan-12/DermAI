# DermAI Environment Configuration Example
DERMAI_JWT_SECRET=your-secure-random-jwt-secret-here
DATABASE_URL=postgresql:///dermai_db

# Email Alert Notification Settings (SMTP)
# Leave SMTP_HOST empty for automated local console simulation mode
# To relay real emails: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER, SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@dermai.clinical
SMTP_USE_TLS=true

